{
  "name": "dsh-skill-management",
  "version": "0.1.0",
  "description": "Skill management for DeepSeek Harness — browse, install, edit, enable/disable and uninstall skills per workspace and globally from a left-sidebar panel. | DeepSeek Harness 技能管理——在左侧栏管理每个工作区与全局安装的技能，支持导入、编辑、启用/停用和卸载。",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "ZJM <zjm960929@outlook.com> (https://github.com/zjm960929)",
  "homepage": "https://github.com/zjm960929/dsh-skill-management#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjm960929/dsh-skill-management.git"
  },
  "bugs": {
    "url": "https://github.com/zjm960929/dsh-skill-management/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "skill",
    "skills",
    "skill-management",
    "workspace",
    "cordis"
  ],
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/skill-store.js && node --check lib/client.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node --check lib/index.js && node --check lib/skill-store.js && node --check lib/client.js"
  }
}
